              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="lokalNummer" type="integer">
            <annotation>
              <documentation>nummerering av lokalitet i forekomsten

Merknad: Er en del av FOREKOM_ID: Eks: 1729001(01)01</documentation>
