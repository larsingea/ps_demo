  "dataCaptureAndProductionSection": {
    "DataAcquisitionAndProcessing": {
      "processStep": [
        {
          "description": "Informasjon om bunnfellingsområder er basert på Bunnsedimenter (kornstørrelse), detaljert. Grunnlaget for tolkning av Bunnsedimenter (kornstørrelse) er video av sjøbunnen, tolkning av digitale reflektivitetsdata, samt tolkning av analoge og digitale seismiske data. Akustiske data og video er verifisert med analyser av bunnprøver. Detaljerte vanndypsdata har inngått som støtte i tolkningen. Datasettet er digitalisert og tilrettelagt vha. ESRI ArcGIS verktøy. Metodikken er beskrevet i egenskapsfeltene Målemetode og GeolPavisningstype. Temakoder og egenskaper følger i hovedsak SOSI-standarden."
        }
      ]
    }
  },
